# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Database (used by docker compose for both the db and the backend)
POSTGRES_USER=valentine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=valentine
# Host port for local access to the db (tests); change if 5432 is taken
DB_HOST_PORT=5432

# Kalshi public API base (reads need no key). Production host:
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2

# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Set to false ONLY for plain-http local use
SESSION_COOKIE_SECURE=true

# LangSmith tracing. If true, the key is required.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Only for the key check: cd backend && uv run python -m app.cli check-kalshi-key
# Run it on your own machine so the key never leaves it. It sends one read-only balance request
# to demo, then production, and prints whether each accepted the key (never the key or balance).
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=/full/path/to/the/private-key.pem
# KALSHI_DEMO_API_BASE=https://external-api.demo.kalshi.co/trade-api/v2
# (uses KALSHI_API_BASE above for production)

# Research (Milestone 2). Without OPENAI_API_KEY research is OFF and starting a run is refused.
OPENAI_API_KEY=
# Optional tuning, shown with their defaults:
# PLANNER_MODEL=gpt-5.4-mini
# RESEARCHER_MODEL=gpt-5.4
# RESEARCH_REASONING_EFFORT=low
# MAX_RESEARCHERS=4
# MAX_SEARCHES_PER_RESEARCHER=3
# RESEARCHER_MAX_OUTPUT_TOKENS=4000
# MAX_CONCURRENT_RUNS=2
# RUN_COST_WARN_USD=3.00
