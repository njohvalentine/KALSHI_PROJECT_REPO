# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Database (used by docker compose for both the db and the backend)
POSTGRES_USER=valentine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=valentine
# Host port for local access to the db (tests); change if 5432 is taken
DB_HOST_PORT=5432

# Kalshi public API base (reads need no key). Production host:
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2

# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Set to false ONLY for plain-http local use
SESSION_COOKIE_SECURE=true

# LangSmith tracing. If true, the key is required.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Only for the key check: cd backend && uv run python -m app.cli check-kalshi-key
# Run it on your own machine so the key never leaves it. It sends one read-only balance request
# to demo, then production, and prints whether each accepted the key (never the key or balance).
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=/full/path/to/the/private-key.pem
# KALSHI_DEMO_API_BASE=https://external-api.demo.kalshi.co/trade-api/v2
# (uses KALSHI_API_BASE above for production)

# Research (Milestone 2). Without OPENAI_API_KEY research is OFF and starting a run is refused.
OPENAI_API_KEY=
# Optional tuning, shown with their defaults:
# PLANNER_MODEL=gpt-5.4-mini
# RESEARCHER_MODEL=gpt-5.4
# RESEARCH_REASONING_EFFORT=low
# MAX_RESEARCHERS=4
# MAX_SEARCHES_PER_RESEARCHER=3
# RESEARCHER_MAX_OUTPUT_TOKENS=4000
# MAX_CONCURRENT_RUNS=2
# RUN_COST_WARN_USD=3.00

# Reading the pages a run cited (Milestone 3). Private and local addresses are always refused.
# FETCH_ENABLED=true
# FETCH_MAX_PAGES_PER_RUN=25
# FETCH_CONCURRENCY=5
# FETCH_TIMEOUT_SECONDS=10
# FETCH_MAX_BYTES=2000000

# Checking each claim against its page (Milestone 3).
# CHECK_ENABLED=true
# CHECKER_MODEL=gpt-5.4-mini
# CHECKER_REASONING_EFFORT=medium
# CHECK_PAGE_CHARS=30000
# CHECKER_MAX_OUTPUT_TOKENS=4000
# CHECK_CONCURRENCY=5

# Forecasters (Milestone 3): independent probability estimates for each outcome of a game.
# FORECASTER_MODEL=gpt-5.4
# FORECASTER_REASONING_EFFORT=medium
# FORECASTER_MAX_OUTPUT_TOKENS=8000
# FORECASTER_COUNT=3

# When a gap to the market price is flagged as meaningful. PLACEHOLDERS until Milestone 4 scores real forecasts.
# EDGE_MIN=0.05
# MIN_SUPPORTED_CLAIMS=5
# MIN_ASK_SIZE=10
# MIN_RESEARCH_SHIFT=0.05     # the research must move our probability this far from the plain AI call, toward the gap
# EDGE_PLAUSIBLE_MAX=0.15    # a gap above this is more likely a model error than an opportunity
# OPPORTUNITY_MAX_AGE_HOURS=12   # an older forecast is shown greyed and never flagged on the Opportunities page

# The watcher: alerts (recorded in the app) and optional automatic research. Off by default.
# MONITOR_ENABLED=false
# Alerts to Telegram. Create a bot with @BotFather in Telegram, open it and press Start, then run
#   docker compose exec backend uv run --no-sync python -m app.cli telegram-chat-id
# and put the two values here. The token is a SECRET: only in .env, never in chat or in the code.
# ALERTS_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# MONITOR_INTERVAL_MINUTES=10
# ALERT_MOVE_CENTS=8                # a market moving this much since our forecast raises an alert
# ALERT_START_SOON_MINUTES=60       # a flagged game starting within this time raises a reminder
# ALERT_COOLDOWN_MINUTES=60         # at most one alert of a kind per game in this time
# ALERT_MAX_PER_HOUR=6              # more than this are held back (and recorded as held back)
# AUTO_RESEARCH_MAX_PER_DAY=0       # 0 = off. Each automatic run costs real money (about 0.35 to 0.65 USD)
# AUTO_RESEARCH_HOURS_AHEAD=24
# AUTO_RESEARCH_MIN_GAP_HOURS=12

# Approval screen (Milestone 5). Orders are SIMULATED: nothing is ever sent to Kalshi.
# The betting limits are PLACEHOLDERS until the client has agreed his own.
# ORDER_MAX_CONTRACTS=10        # most contracts in one order
# ORDER_MAX_COST_USD=5.00       # most one order may cost (price times contracts plus fee)
# ORDER_MAX_DAY_COST_USD=20.00  # most all orders approved in one UTC day may cost
# ORDER_EXPIRY_MINUTES=10       # a prepared order must be approved and placed within this time
# ORDER_MAX_SLIPPAGE_CENTS=2    # the price may move this much against us between preparing and placing
# TICKET_MAX_LEGS=4             # most games in one ticket (a combo); several legs multiply the model's errors

# Early record of forecasts (for scoring against what happened).
# RECORD_BASELINE=true       # one extra call per game with no research, the plain-AI comparison
# RESOLVE_AFTER_HOURS=3      # look for a game's result this long after its start

# Games list (Markets page). Which Kalshi series to show, as Sport:SERIES_TICKER:League label,
# comma separated. Leave unset for the default list of major soccer, baseball and tennis series.
# SPORTS_SERIES=Soccer:KXEPLGAME:Premier League,Baseball:KXMLBGAME:MLB,Tennis:KXATPMATCH:ATP
# GAMES_CACHE_SECONDS=60
# SPORTS_FETCH_CONCURRENCY=6
